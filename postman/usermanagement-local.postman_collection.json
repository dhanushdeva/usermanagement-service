{
  "info": {
    "name": "User Management - local",
    "description": "All 15 endpoints of usermanagement-service (same as bm-usermanagement-v4) against the local Keycloak. Select the 'usermanagement-local' environment, run '00 Get token' first, then the requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "00 Get token (Keycloak)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token received', () => pm.response.to.have.status(200));",
              "pm.environment.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "client_id", "value": "{{clientId}}", "type": "text" },
            { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "scope", "value": "openid", "type": "text" },
            { "key": "username", "value": "{{username}}", "type": "text" },
            { "key": "password", "value": "{{password}}", "type": "text" }
          ]
        },
        "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
      }
    },
    {
      "name": "01 anonymous (public)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/anonymous"
      }
    },
    {
      "name": "02 addRole",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"roles\": {\n    \"name\": \"{{testRole}}\",\n    \"description\": \"Role created from Postman\"\n  }\n}" },
        "url": "{{baseUrl}}/usermanagement/addRole"
      }
    },
    {
      "name": "03 validateIdpRole (hidden)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"configurations\": {\n    \"role.name\": \"{{testRole}}\"\n  }\n}" },
        "url": "{{baseUrl}}/usermanagement/validateIdpRole"
      }
    },
    {
      "name": "04 getRoleAndComposite (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/getRoleAndComposite?roleName={{testRole}}"
      }
    },
    {
      "name": "05 createRoleIfNotExist (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/createRoleIfNotExist?roleName=AUTO_ROLE"
      }
    },
    {
      "name": "06 register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('user created', () => pm.response.to.have.status(201));",
              "pm.environment.set('userId', pm.response.json().userId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"user\": {\n    \"userName\": \"{{testUserName}}\",\n    \"password\": \"Pass@123\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"roles\": [\"{{testRole}}\"],\n    \"entityType\": \"CUSTOMER\",\n    \"entityId\": \"CUST-1001\",\n    \"additionalAttributes\": [\n      { \"key\": \"region\", \"value\": \"IN\" }\n    ],\n    \"status\": \"ENABLE\"\n  }\n}" },
        "url": "{{baseUrl}}/usermanagement/register"
      }
    },
    {
      "name": "07 getUsers (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/getUsers?search={{testUserName}}"
      }
    },
    {
      "name": "08 getUserById (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/getUserById?userId={{userId}}"
      }
    },
    {
      "name": "09 getUserInformation (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/getUserInformation?userId={{userId}}"
      }
    },
    {
      "name": "10 updateUser",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"user\": {\n    \"userId\": \"{{userId}}\",\n    \"firstName\": \"Johnny\",\n    \"lastName\": \"Doe\",\n    \"email\": \"johnny.doe@example.com\",\n    \"additionalAttributes\": [\n      { \"key\": \"region\", \"value\": \"EU\" }\n    ],\n    \"status\": \"ENABLE\"\n  }\n}" },
        "url": "{{baseUrl}}/usermanagement/updateUser"
      }
    },
    {
      "name": "11 changeUserStatus - DISABLE",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"status\": \"DISABLE\"\n}" },
        "url": "{{baseUrl}}/usermanagement/changeUserStatus"
      }
    },
    {
      "name": "12 changeUserStatus - ENABLE",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"status\": \"ENABLE\"\n}" },
        "url": "{{baseUrl}}/usermanagement/changeUserStatus"
      }
    },
    {
      "name": "13 resendVerificationMail (hidden) - expect 404 UM112 while email verification is off",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/resendVerificationMail?userId={{userId}}"
      }
    },
    {
      "name": "14 retrieveAndDeleteAnonymousUser (hidden)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usermanagement/retrieveAndDeleteAnonymousUser"
      }
    },
    {
      "name": "15 deleteUsers",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userIds\": [\"{{userId}}\"]\n}" },
        "url": "{{baseUrl}}/usermanagement/deleteUsers"
      }
    },
    {
      "name": "16 deleteRole",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"roleName\": \"{{testRole}}\"\n}" },
        "url": "{{baseUrl}}/usermanagement/deleteRole"
      }
    },
    {
      "name": "17 deleteRole - AUTO_ROLE (cleanup)",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"roleName\": \"AUTO_ROLE\"\n}" },
        "url": "{{baseUrl}}/usermanagement/deleteRole"
      }
    }
  ]
}
